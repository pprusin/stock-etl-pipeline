# AWS S3 - bronze layer upload (src/extract.py -> upload_to_s3)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# tickers list
TICKERS=              # optional, comma-separated, defaults to the basket hardcoded in extract.py
PERIOD=5y              # optional, but must have a value - an empty string overrides the "5y" default

# Neon/Supabase Postgres connection string (required only for load_to_postgres.py and the dashboard)
DATABASE_URL=

# Databricks (required only for triggering the ETL job, e.g. from GitHub Actions)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
